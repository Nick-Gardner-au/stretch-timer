{
  "name": "training-desktop",
  "productName": "Training",
  "version": "1.0.0",
  "description": "Stretch Timer, Pilates Mat and Mobility as a Linux desktop app",
  "homepage": "https://github.com/Nick-Gardner-au/stretch-timer",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nick-Gardner-au/stretch-timer.git"
  },
  "author": "Training",
  "main": "main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "copy-web": "node scripts/copy-web.js",
    "start": "npm run copy-web && electron .",
    "dist": "npm run copy-web && electron-builder --linux",
    "dist:linux": "npm run copy-web && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.stretchtimer.training",
    "productName": "Training",
    "files": [
      "main.js",
      "web/**/*",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Training"
    },
    "publish": null
  }
}
